# Эти переменные нужно добавить в Vercel → Settings → Environment Variables.
# Файл .env из репозитория Vercel НЕ читает — он работает только локально
# при `vercel dev`. Сам .env в git не коммитить.

# --- обязательное: токен бота от @BotFather ---
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- желательное: кому слать ---
# Если не задать, бот отправит тому, кто последним ему написал.
# Работает, но узнать id надёжнее: напиши @userinfobot
# TELEGRAM_CHAT_ID=123456789

# --- необязательное ---
# Часовой пояс для времени в сообщении
# NOTIFY_TZ=Asia/Almaty
# Продублировать уведомление в Discord
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
# Домен, с которого разрешены запросы (если не задан — проверяется свой же хост)
# ALLOW_ORIGIN=https://prosti-menya.vercel.app
