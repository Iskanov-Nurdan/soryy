# Скопируй нужные строки в Vercel → Settings → Environment Variables.
# Сам файл .env в git не коммитить.

# --- Telegram (рекомендую) ---
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Твой chat_id — узнать у бота @userinfobot
TELEGRAM_CHAT_ID=123456789

# --- Discord (по желанию, вместо телеграма или вместе с ним) ---
# Настройки канала → Integrations → Webhooks → Copy Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# --- необязательное ---
# Часовой пояс для времени в сообщении
NOTIFY_TZ=Asia/Almaty
# Домен, с которого разрешены запросы (если не задан — проверяется свой же хост)
# ALLOW_ORIGIN=https://prosti-menya.vercel.app
